# 原版对 GLScene v1.1 的本地补丁（Magnetic Adventure）
#
# 基线：GLScene v1.1 发布包（SourceForge, 2010-08）的 Source/ 树
# 应用：在树的上一级 `patch -p1 < glscene-v11-game.patch`
# 作用：让 GLScene 的机器码与原版 game.exe 逐指令一致（F211/F212/F213）
#   - GLBitmapFont: SetHSpace/SetVSpace 下限钳位；文本 API 改 WideString；
#                   CalcStringWidth/RenderString 声明为 virtual
#   - GLHUDObjects: TGLHUDText.FText 改 WideString
#   - GLScene:      TGLSceneBuffer.DestroyRC 去掉 RemoveBuffer 调用
#   - GLTexture:    Assign 增加 TGLPNGImage 分支（uses GLFilePNG）
#   - GLLCLViewer:  LMEraseBkgnd 恒返回 1；LMPaint 去掉 WM_SIZE workaround
#
diff --git a/Source/GLBitmapFont.pas b/Source/GLBitmapFont.pas
index 55789fd..b04d6c8 100644
--- a/Source/GLBitmapFont.pas
+++ b/Source/GLBitmapFont.pas
@@ -214,9 +214,9 @@ type
        of rotated and linear distorted text with this method, OpenGL
        Enable states are also possibly altered. }
     procedure RenderString(var rci: TRenderContextInfo;
-      const aString: AnsiString; alignment: TAlignment;
+      const aString: WideString; alignment: TAlignment;
       layout: TGLTextLayout; const color: TColorVector;
-      position: PVector = nil; reverseY: Boolean = False);
+      position: PVector = nil; reverseY: Boolean = False); virtual;
     {: A simpler canvas-style TextOut helper for RenderString.<p>
        The rendering is reversed along Y by default, to allow direct use
        with TGLCanvas }
@@ -227,7 +227,7 @@ type
     {: Get the actual width for this char. }
     function GetCharWidth(ch: AnsiChar): Integer;
     {: Get the actual pixel width for this string. }
-    function CalcStringWidth(const st: AnsiString): Integer;
+    function CalcStringWidth(const st: WideString): Integer; virtual;
 
     {: Height of a single character. }
     property CharHeight: Integer read FCharHeight write SetCharHeight default 16;
@@ -589,7 +589,7 @@ end;
 // CalcStringWidth
 //
 
-function TGLCustomBitmapFont.CalcStringWidth(const st: AnsiString): Integer;
+function TGLCustomBitmapFont.CalcStringWidth(const st: WideString): Integer;
 var
   i: Integer;
 begin
@@ -714,7 +714,10 @@ procedure TGLCustomBitmapFont.SetHSpace(const val: Integer);
 begin
   if val <> FHSpace then
   begin
-    FHSpace := val;
+    if val > 1 then
+      FHSpace := val
+    else
+      FHSpace := 1;
     InvalidateUsers;
   end;
 end;
@@ -726,7 +729,10 @@ procedure TGLCustomBitmapFont.SetVSpace(const val: Integer);
 begin
   if val <> FVSpace then
   begin
-    FVSpace := val;
+    if val > 1 then
+      FVSpace := val
+    else
+      FVSpace := 1;
     InvalidateUsers;
   end;
 end;
@@ -873,7 +879,7 @@ end;
 //
 
 procedure TGLCustomBitmapFont.RenderString(var rci: TRenderContextInfo;
-  const aString: AnsiString; alignment: TAlignment;
+  const aString: WideString; alignment: TAlignment;
   layout: TGLTextLayout; const color: TColorVector; position: PVector = nil;
   reverseY: Boolean = False);
 
